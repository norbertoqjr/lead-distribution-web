# Copy to .env.local and fill in. Never commit .env.local.
NODE_ENV=development
PORT=8192

# Internal API base URL. Server-side only — no NEXT_PUBLIC_ prefix, or the
# private backend port would be inlined into the browser bundle.
BACKEND_URL=http://127.0.0.1:8193

# Must match the API's cookie name.
SESSION_COOKIE_NAME=lds_session
